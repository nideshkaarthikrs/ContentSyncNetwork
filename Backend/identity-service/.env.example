PORT=3001
NODE_ENV=development
SERVICE_NAME=identity-service

# PostgreSQL — identity-service owns its own DB
DATABASE_URL=postgresql://user:pass@localhost:5432/csn_identity

# JWT
JWT_SECRET=your-jwt-secret-change-in-production
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# NOTE: when run via the root docker-compose.yml/docker-compose.dev.yml,
# DATABASE_URL and any *_SERVICE_URL vars above are overridden to point at
# the other containers by Docker DNS name. The values here are the
# bare-metal/localhost fallback for running this service outside Docker.
