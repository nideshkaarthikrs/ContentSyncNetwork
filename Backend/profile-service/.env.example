PORT=3002
NODE_ENV=development
SERVICE_NAME=profile-service

# PostgreSQL — profile-service owns its own DB
DATABASE_URL=postgresql://csn:csn_pass@localhost:5433/csn_profile

# JWT — shared secret with identity-service
JWT_SECRET=your-jwt-secret-change-in-production

# Internal service-to-service auth — shared secret across all services
INTERNAL_SERVICE_SECRET=your-internal-secret-change-in-production
NOTIFICATION_SERVICE_URL=http://localhost:3013

# NOTE: when run via the root docker-compose.yml/docker-compose.dev.yml,
# DATABASE_URL and any *_SERVICE_URL vars above are overridden to point at
# the other containers by Docker DNS name. The values here are the
# bare-metal/localhost fallback for running this service outside Docker.
