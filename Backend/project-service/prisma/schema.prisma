datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Project {
  id             String        @id @default(uuid())
  sequenceNumber Int           @default(autoincrement())
  projectName    String
  ownerId        String
  ownerUserId    String
  status         ProjectStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  members        ProjectMember[]
  files          ProjectFile[]
}

model ProjectMember {
  id            String       @id @default(uuid())
  projectId     String
  userDisplayId String
  role          String
  inviteStatus  InviteStatus @default(PENDING)
  createdAt     DateTime     @default(now())
  project       Project      @relation(fields: [projectId], references: [id])

  @@unique([projectId, userDisplayId])
}

model ProjectFile {
  id             String   @id @default(uuid())
  sequenceNumber Int      @default(autoincrement())
  projectId      String
  uploaderId     String
  uploaderUserId String
  filename       String
  fileUrl        String
  fileSize       Int?
  mimeType       String?
  createdAt      DateTime @default(now())
  project        Project  @relation(fields: [projectId], references: [id])

  @@map("project_files")
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
}
