# LAN IP of the machine running the backend services (no trailing slash, no port).
# The Expo app runs on a physical phone, so `localhost` will NOT resolve to your dev
# machine — you must use its LAN IP. Find it with:
#   macOS:   ipconfig getifaddr en0
#   Windows: ipconfig  (look for IPv4 Address on your active adapter)
# Update this whenever your Wi-Fi network or IP changes.
EXPO_PUBLIC_API_HOST=http://192.168.1.41
