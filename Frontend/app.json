{
  "expo": {
    "name": "CSN",
    "slug": "CSN",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#3957FF"
    },
    "android": {
      "package": "com.vapkotech.csn",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#3957FF"
      }
    },
    "ios": {
      "bundleIdentifier": "com.vapkotech.csn",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "Allow CSN to record and send voice notes."
      }
    },
    "owner": "vapkotech",
    "plugins": [
      "expo-font",
      "@livekit/react-native-expo-plugin",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow CSN to select photos and videos.",
          "cameraPermission": "Allow CSN to take photos and videos.",
          "microphonePermission": "Allow CSN to record audio while capturing videos."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow CSN to use your location to find nearby community groups."
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "091188f5-c692-471a-a2af-0823476cc05d"
      }
    }
  }
}
